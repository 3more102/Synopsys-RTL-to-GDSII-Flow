# Copy to .env.local, edit real paths/cells/layers, then: source setup.sh
# .env.local is ignored by Git.

export PROJECT_NAME=MIPS_16
export TOP_MODULE=mips_16
export TECHNOLOGY=SAED90nm
export PROCESS_NODE=90nm

# Tool executables
export DC_SHELL=dc_shell
export ICC2_SHELL=icc2_shell
export PT_SHELL=pt_shell
export FM_SHELL=fm_shell
export STARRC=StarXtract
export ICV=icv
export PYTHON=python3

# Logical/physical libraries: MUST be real files from your installation.
export TARGET_LIBRARY=/absolute/path/to/saed90nm_max_hvt.db
export STD_CELL_NDM=/absolute/path/to/saed90nm_hvt_mips.ndm
# Optional extra .db libraries separated by ':'
# export EXTRA_LINK_LIBS=/path/a.db:/path/b.db

# Technology / extraction
# export TECH_FILE=/absolute/path/to/technology.tf
# export TLU_PLUS_MAX=/absolute/path/to/max.tluplus
# export TLU_PLUS_MIN=/absolute/path/to/min.tluplus
# export TLU_PLUS_MAP=/absolute/path/to/tluplus.map
export GDS_LAYER_MAP=/absolute/path/to/gdsout.map

# Real PDK routing layers. No defaults are guessed.
export PG_RING_H_LAYER=<actual_layer>
export PG_RING_V_LAYER=<actual_layer>
export PG_MESH_H_LAYER=<actual_layer>
export PG_MESH_V_LAYER=<actual_layer>
export PG_STD_CELL_RAIL_LAYER=<actual_std_cell_rail_layer>

# Optional CTS physical policy; leave empty to use library/tool defaults.
# export CTS_MIN_ROUTING_LAYER=<actual_layer>
# export CTS_MAX_ROUTING_LAYER=<actual_layer>
# export CTS_TARGET_SKEW=0.10
# export CTS_TARGET_LATENCY=1.0
# export CTS_NDR_MULTIPLIER=2

# Project timing/floorplan methodology
export CLOCK_NAME=clk
export CLOCK_PORT=clk
export CLOCK_PERIOD=10.0
export INPUT_TRANSITION=0.10
# export ASYNC_CONTROL_PORTS="reset_n"   # only if architecturally justified
export CORE_UTILIZATION=0.65
export CORE_ASPECT_RATIO=1.0
export CORE_OFFSET=10

# Optional RTL preprocessing
# export RTL_FILELIST=/absolute/path/to/rtl.f
# export RTL_INCLUDE_DIRS=/path/inc1:/path/inc2
# export RTL_DEFINES='SYNTHESIS WIDTH=16'

# Special cells: use exact lib_cell references discovered from your NDM.
# export TAP_CELLS='lib/TAP_CELL'
# export ENDCAP_CELLS='lib/ENDCAP_L lib/ENDCAP_R'
# export FILLER_CELLS='lib/FILL8 lib/FILL4 lib/FILL2 lib/FILL1'
# export CTS_CELLS='lib/CLKBUF1 lib/CLKBUF2 lib/CLKINV1'
# export HOLD_CELLS='lib/BUF1 lib/BUF2'
# export TIE_HIGH_CELLS='lib/TIEHI'
# export TIE_LOW_CELLS='lib/TIELO'
