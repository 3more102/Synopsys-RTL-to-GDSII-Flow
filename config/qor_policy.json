{
  "schema_version": 1,
  "description": "Default QoR regression/closure policy. Timing signoff rules are hard gates. PPA/runtime allowances are methodology defaults and should be reviewed per project.",
  "stages": {
    "Synthesis": {
      "Area": {"direction": "lower", "max_regression_percent": 5.0, "severity": "warn", "require_current": false, "require_baseline": false},
      "Power": {"direction": "lower", "max_regression_percent": 5.0, "severity": "warn", "require_current": false, "require_baseline": false}
    },
    "Placement": {
      "WNS": {"direction": "higher", "max_regression_abs": 0.0, "severity": "fail", "require_current": false, "require_baseline": false},
      "TNS": {"direction": "higher", "max_regression_abs": 0.0, "severity": "fail", "require_current": false, "require_baseline": false},
      "Area": {"direction": "lower", "max_regression_percent": 5.0, "severity": "warn", "require_current": false, "require_baseline": false},
      "Congestion": {"direction": "lower", "max_regression_percent": 10.0, "severity": "warn", "require_current": false, "require_baseline": false}
    },
    "Post-Route": {
      "WNS": {"direction": "higher", "max_regression_abs": 0.0, "severity": "fail", "require_current": false, "require_baseline": false},
      "TNS": {"direction": "higher", "max_regression_abs": 0.0, "severity": "fail", "require_current": false, "require_baseline": false},
      "Worst Hold Slack": {"direction": "higher", "max_regression_abs": 0.0, "severity": "fail", "require_current": false, "require_baseline": false},
      "DRC": {"direction": "lower", "absolute_max": 0.0, "severity": "fail", "require_current": false, "require_baseline": false}
    },
    "Signoff": {
      "WNS": {"direction": "higher", "absolute_min": 0.0, "max_regression_abs": 0.0, "severity": "fail", "require_current": true, "require_baseline": true},
      "TNS": {"direction": "higher", "absolute_min": 0.0, "max_regression_abs": 0.0, "severity": "fail", "require_current": true, "require_baseline": true},
      "Worst Hold Slack": {"direction": "higher", "absolute_min": 0.0, "max_regression_abs": 0.0, "severity": "fail", "require_current": true, "require_baseline": true},
      "Power": {"direction": "lower", "max_regression_percent": 5.0, "severity": "warn", "require_current": false, "require_baseline": false},
      "Runtime": {"direction": "lower", "max_regression_percent": 25.0, "severity": "warn", "require_current": false, "require_baseline": false}
    }
  }
